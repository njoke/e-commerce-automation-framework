          "name": "POST /api/checkout - Valid checkout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/api/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\"userId\": \"{{userId}}\", \"firstName\": \"Jane\", \"lastName\": \"Doe\", \"email\": \"jane@example.com\", \"address\": \"123 Elm St\", \"city\": \"Seattle\", \"state\": \"WA\", \"zip\": \"98101\", \"cardNumber\": \"4111111111111111\", \"items\": [{\"productId\": \"prod-001\", \"quantity\": 1, \"price\": 299.99}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Returns orderId', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.orderId).to.be.a('string');",
                  "  pm.expect(json.orderId).to.include('ORD');",
                  "});",
                  "pm.test('Returns subtotal, tax, total', () => {",
