                  "  pm.expect(json.subtotal).to.be.a('number');",
                  "  pm.expect(json.tax).to.be.a('number');",
                  "  pm.expect(json.total).to.be.a('number');",
                  "  pm.expect(json.total).to.equal(json.subtotal + json.tax);",
                  "});"
                ]
              }
            }
