  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health - Returns 200 ok",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has status ok', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.equal('ok');",
                  "});",
                  "pm.test('Body has timestamp', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/login - Valid credentials",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"{{validUsername}}\", \"password\": \"{{validPassword}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns userId, username, token', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.include.all.keys('userId', 'username', 'token');",
                  "});",
                  "pm.test('Token is a string', () => {",
                  "  pm.expect(pm.response.json().token).to.be.a('string');",
                  "});",
                  "const json = pm.response.json();",
                  "pm.environment.set('userId', json.userId);",
                  "pm.environment.set('token', json.token);"
                ]
              }
            }
          ]
        },
