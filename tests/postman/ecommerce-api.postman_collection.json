                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "pm.test('Cart contains the added product', () => {",
                  "  const cart = pm.response.json();",
                  "  const item = cart.find(i => i.productId === pm.environment.get('productId'));",
