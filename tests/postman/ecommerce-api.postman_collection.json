    {
      "name": "Products",
      "item": [
        {
          "name": "GET /api/products - Returns all products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is array', () => {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "pm.test('Array is not empty', () => {",
                  "  pm.expect(pm.response.json().length).to.be.greaterThan(0);",
                  "});",
                  "pm.test('Each product has required fields', () => {",
                  "  pm.response.json().forEach(p => {",
                  "    pm.expect(p).to.have.all.keys('id', 'name', 'description', 'category', 'price', 'imageUrl', 'inStock', 'rating');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/products?search=headphone",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?search=headphone"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns filtered results', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.be.an('array');",
                  "  pm.expect(json.length).to.be.greaterThan(0);",
                  "  json.forEach(p => {",
                  "    pm.expect(p.name.toLowerCase() + p.description.toLowerCase() + p.category.toLowerCase()).to.include('headphone');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/products?sort=price_asc",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?sort=price_asc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Products sorted price ascending', () => {",
                  "  const prices = pm.response.json().map(p => p.price);",
                  "  for (let i = 1; i < prices.length; i++) {",
                  "    pm.expect(prices[i]).to.be.at.least(prices[i - 1]);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/products?sort=price_desc",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?sort=price_desc"
